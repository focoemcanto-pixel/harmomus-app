{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harmomus-app",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  }
}
